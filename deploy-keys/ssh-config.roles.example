# OWNER TEMPLATE: activate only after all five hosts pass S3 and collector/WSL checks.
# Replace duplicate alias blocks; retain an independent recovery route (Windows restart drops SSH).
# S2 verification may add only the individual *-admin HostName/User blocks below.
# At activation keep these aliases in machines.json and update their user metadata to deploy.
# See RUNBOOK.md before switching ROTATION-STATE to s3-applied.
Host vps-deploy vps-admin ob-deploy ob-admin ivybox-deploy ivybox-admin gb-deploy gb-admin rs-deploy rs-admin
    IdentitiesOnly yes
    IdentityAgent none
    ForwardAgent no

Host vps-deploy ob-deploy ivybox-deploy gb-deploy rs-deploy
    IdentityFile ~/.ssh/deploy-certs/current-daily/deployer
    CertificateFile ~/.ssh/deploy-certs/current-daily/deployer-cert.pub

Host vps-admin ob-admin ivybox-admin gb-admin rs-admin
    IdentityFile ~/.ssh/deploy-certs/current-admin/deployer
    CertificateFile ~/.ssh/deploy-certs/current-admin/deployer-cert.pub

Host vps-deploy
    HostName 138.199.198.246
    User deploy

Host vps-admin
    HostName 138.199.198.246
    User root

Host ob-deploy
    HostName 178.104.80.26
    User deploy

Host ob-admin
    HostName 178.104.80.26
    User root

Host ivybox-deploy
    HostName 168.119.52.183
    User deploy

Host ivybox-admin
    HostName 168.119.52.183
    User root

Host gb-deploy
    HostName 100.80.44.86
    User deploy

Host gb-admin
    HostName 100.80.44.86
    User vibe

Host rs-deploy
    HostName 100.124.95.60
    User deploy

Host rs-admin
    HostName 100.124.95.60
    User misterisley
