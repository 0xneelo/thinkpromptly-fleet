{
  "name": "fleetdeck",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "start": "node server.js",
    "build:claude-bridge": "sh scripts/build-claude-bridge.sh",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper || true",
    "pretest": "node scripts/check-deps.js && node tools/extract-fixture.mjs --check",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "v2:fixture": "node tools/extract-fixture.mjs",
    "v2:fixture:check": "node tools/extract-fixture.mjs --check"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.0.0",
    "ws": "^8.18.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
